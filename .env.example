LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
SIMLI_API_KEY=your-simli-api-key

# ── AI provider keys ──
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Task 1: gender detection (vision) ──
GENDER_PROVIDER=gemini            # openai | gemini
GENDER_MODEL_GEMINI=gemini-3-flash-preview
GENDER_MODEL_OPENAI=gpt-5-nano

# ── Task 2: avatar image edit (chained prompts) ──
IMAGE_PROVIDER=gemini             # openai | gemini
IMAGE_MODEL_GEMINI=nano-banana-pro-preview
IMAGE_MODEL_OPENAI=gpt-image-1

# ── Task 3: in-call LLM (LiveKit worker) ──
LLM_PROVIDER=gemini               # openai | gemini
LLM_MODEL_OPENAI=gpt-5-mini
LLM_MODEL_GEMINI=gemini-3-flash-preview

# ── Task 4: STT (LiveKit worker) ──
STT_PROVIDER=deepgram             # deepgram | openai
STT_MODEL=nova-3-general

# ── Task 5: TTS (LiveKit worker) ──
TTS_PROVIDER=elevenlabs           # elevenlabs | openai | google
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=

# ── Simli defaults ──
DEFAULT_SIMLI_FACE_ID=
DEFAULT_SIMLI_VOICE_PROVIDER=elevenlabs
DEFAULT_SIMLI_VOICE_MODEL=eleven_flash_v2_5
DEFAULT_SIMLI_VOICE_ID=

# ── Azure Key Vault (service principal that reads per-tenant secrets) ──
# The SP needs `get` permission on secrets in the vault.
# Per-tenant secrets follow the naming convention
#   {tenant_id}-db-url
#   {tenant_id}-blob-account-url
#   {tenant_id}-blob-account-name
#   {tenant_id}-blob-account-key
#   {tenant_id}-blob-container
# Provision them via scripts/create_tenant.py.
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Optional tuning.
TENANT_SECRET_TTL_SECONDS=600
