LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
SIMLI_API_KEY=your-simli-api-key
SIMLI_TRANSPORT=livekit           # livekit | auto
SIMLI_FACE_MODEL=legacy           # legacy | trinity — face-creation endpoint. trinity = GS faces, needs a Simli plan with GS-face quota (else 403 "max GS Faces")
SIMLI_CALL_MODEL=trinity          # legacy | trinity — live call/render model

# ── AI provider keys ──
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Task 1: gender detection (vision) ──
GENDER_PROVIDER=azure_openai      # openai | gemini | azure_openai
GENDER_MODEL_GEMINI=gemini-3-flash-preview
GENDER_MODEL_OPENAI=gpt-5-nano
GENDER_MODEL_AZURE_OPENAI=gpt-4o

# ── Task 2: avatar image edit (chained prompts) ──
IMAGE_PROVIDER=azure_openai       # openai | gemini | azure_openai
IMAGE_MODEL_GEMINI=nano-banana-pro-preview
IMAGE_MODEL_OPENAI=gpt-image-1

# ── Task 3: in-call LLM (LiveKit worker) ──
CALL_LLM_PROVIDER=azure_openai    # openai | gemini | azure_openai
CALL_LLM_MODEL_OPENAI=gpt-4o-mini
CALL_LLM_MODEL_GEMINI=gemini-3-flash-preview
CALL_LLM_MODEL_AZURE_OPENAI=gpt-4o

# ── Task 4: STT (LiveKit worker) ──
STT_PROVIDER=deepgram             # deepgram | openai
STT_MODEL=nova-3-general

# ── Task 5: TTS (LiveKit worker) ──
TTS_PROVIDER=elevenlabs           # elevenlabs | openai | google
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=

# ── Simli defaults ──
DEFAULT_SIMLI_FACE_ID=
DEFAULT_SIMLI_VOICE_PROVIDER=elevenlabs
DEFAULT_SIMLI_VOICE_MODEL=eleven_flash_v2_5
DEFAULT_SIMLI_VOICE_ID=

# ── Azure OpenAI (used when *_PROVIDER=azure_openai) ──
# gpt-4o resource — chat + vision (gender detection, voice description,
# in-call LLM).
AZURE_OPENAI_ENDPOINT=https://<chat-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# gpt-image-2 resource — avatar image edits / generation.
AZURE_IMAGE_ENDPOINT=https://<image-resource>.cognitiveservices.azure.com/
AZURE_IMAGE_API_KEY=
# gpt-image-2 /images/edits requires 2025-04-01-preview or newer.
AZURE_IMAGE_API_VERSION=2025-04-01-preview
AZURE_IMAGE_DEPLOYMENT=gpt-image-2

# ── Azure Key Vault (service principal that reads per-tenant secrets) ──
# The SP needs `get` permission on secrets in the vault.
# Per-tenant secrets follow the naming convention
#   tenant-{tenant_id}-db-url
#   tenant-{tenant_id}-blob-account-url
#   tenant-{tenant_id}-blob-account-name
#   tenant-{tenant_id}-blob-account-key
#   tenant-{tenant_id}-blob-container
# Provision them via scripts/create_tenant.py.
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Optional tuning.
TENANT_SECRET_TTL_SECONDS=600
